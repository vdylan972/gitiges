{
  "name": "plezipeyi-reel",
  "version": "1.0.0",
  "description": "PleziPeyi — Reel Instagram « Soyez là quand ça compte » (Remotion)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/fonts": "^4.0.538",
    "@remotion/media-parser": "^4.0.538",
    "@remotion/paths": "^4.0.538",
    "@remotion/studio": "^4.0.538",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.538",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "check-assets": "tsx scripts/check-assets.ts",
    "check-timeline": "tsx scripts/check-timeline.ts",
    "render": "remotion render PleziPeyiReel out/plezipeyi-reel-v1.mp4",
    "render:nomusic": "remotion render PleziPeyiReel out/plezipeyi-reel-v1-nomusic.mp4 --props='{\"withMusic\":false}'",
    "render:safezones": "remotion render PleziPeyiReel out/plezipeyi-reel-v1-safezones.mp4 --props='{\"showSafeZones\":true}'",
    "render:cover": "remotion still Cover out/cover-1080x1920.png",
    "render:stills": "tsx scripts/render-stills.ts",
    "render:all": "npm run check-assets && npm run check-timeline && npm run render && npm run render:nomusic && npm run render:safezones && npm run render:cover && npm run render:stills",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
