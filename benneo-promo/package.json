{
  "name": "benneo-promo",
  "version": "1.0.0",
  "private": true,
  "description": "Vidéo de présentation Benneo en motion design (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render BenneoPromo out/benneo-promo.mp4",
    "render:music": "remotion render BenneoPromo out/benneo-promo.mp4 --props='{\"withMusic\":true}'",
    "still": "remotion still BenneoPromo out/still.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.531",
    "@remotion/google-fonts": "^4.0.531",
    "@remotion/transitions": "^4.0.531",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.531"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
